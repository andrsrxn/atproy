---
import Button from '@/components/Button.astro'
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'article'> {
  name: string
  icon: any
  services: string[]
  keyword: string
}

const {
  keyword,
  name,
  icon: Icon,
  services,
  class: classes,
  ...props
} = Astro.props
---

<article
  class={`service-card flex flex-col gap-4 bg-white rounded-md shadow-lg p-5 relative group overflow-hidden ${classes}`}
  {...props}>
  <div
    class='size-16 rounded-md flex justify-center items-center bg-secondary-light/30 text-secondary'>
    <Icon class='size-10' />
  </div>
  <h3 class='font-semibold text-xl'>{name}</h3>
  <ul
    class={`flex-1 *:text-gray-500 *:list-disc *:marker:text-details *:marker:text-lg pl-5  flex flex-col gap-1 text-pretty ${services.length > 12 && 'md:grid md:grid-cols-2 md:gap-x-6'}`}>
    {services.map(service => <li>{service}</li>)}
  </ul>
  <Button
    full
    class='mt-4'
    variant='default'
    buttonType='link'
    href={`mailto:info@grupoatproy.com?subject=Cotización de servicios ${keyword}`}>
    Solicitar servicio
  </Button>
</article>
