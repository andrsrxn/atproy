---
interface Props {
  title: string
  description: string
  icon?: any
}

const { title, description, icon: Icon } = Astro.props
---

<div class='flex flex-col gap-2'>
  {
    Icon && (
      <div class='text-secondary mb-2 size-10 flex items-center justify-center rounded-md bg-secondary-light/25 xl:size-14'>
        <Icon class='size-5 xl:size-8' />
      </div>
    )
  }
  <h3 class='text-lg font-semibold xl:text-xl'>{title}</h3>
  <p class='text-gray-500 text-sm text-pretty xl:text-base'>{description}</p>
</div>
