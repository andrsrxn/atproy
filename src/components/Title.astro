---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'h1'> {}
const { class: classes, ...props } = Astro.props
---

<h1
  class={`text-[3rem] text-primary-dark md:text-[3.5rem]  md:max-w-[90%] xl:text-[4.5rem]  max-w-[95%] mx-auto leading-[1.1] text-center font-extrabold text-balance ${classes}`}
  {...props}>
  <slot />
</h1>
