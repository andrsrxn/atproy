---
interface Props {
  title: string
  description: string
  image: ImageMetadata
}

const { title, description, image } = Astro.props
---

<article>
  <div
    class={`rounded-md shadow-lg bg-white overflow-hidden min-h-[400px] h-full flex flex-col`}>
    <div class='relative'>
      <img
        src={image.src}
        loading='lazy'
        decoding='async'
        class='h-[270px] object-cover'
        alt={title}
      />

      <div
        class='absolute w-full h-[100px] bg-gradient-to-t from-white to-transparent bottom-0'>
      </div>
    </div>
    <div class='p-6 flex flex-col gap-2 lg:gap-4 relative'>
      <h3 class='text-xl font-bold lg:text-2xl'>{title}</h3>
      <p class='text-gray-500 font-normal'>
        {description}
      </p>
    </div>
  </div>
</article>
