---
import type { HTMLAttributes } from 'astro/types'

interface Base {
  full: boolean
  variant: 'default' | 'secondary'
}

interface ButtonBase extends Base, HTMLAttributes<'button'> {
  buttonType: 'button'
}

interface LinkBase extends Base, HTMLAttributes<'a'> {
  buttonType: 'link'
}

type Props = ButtonBase | LinkBase

const {
  variant,
  full,
  buttonType = 'button',
  class: classes,
  ...props
} = Astro.props
---

{
  buttonType === 'button' ? (
    <button
      class={`py-2 px-6 rounded-md ${variant === 'default' ? 'bg-primary text-white hover:bg-primary/90' : 'bg-white  text-primary hover:bg-gray-100'} shadow-md font-medium text-center xl:py-2.5 xl:px-6 xl:text-base ${full && 'w-full'} ${classes}`}
      {...(props as HTMLAttributes<'button'>)}>
      <slot />
    </button>
  ) : (
    <a
      {...(props as HTMLAttributes<'a'>)}
      class={`py-2 px-6 rounded-md ${variant === 'default' ? 'bg-primary text-white hover:bg-primary/90' : 'bg-white  text-primary hover:bg-gray-100'} shadow-md font-medium text-center xl:py-2.5 xl:px-6 xl:text-base ${full && 'w-full'} ${classes}`}>
      <slot />
    </a>
  )
}
